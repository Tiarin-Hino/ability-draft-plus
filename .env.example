# API Configuration (for screenshot submission to data collection server)
API_ENDPOINT_URL=
CLIENT_API_KEY=
CLIENT_SHARED_SECRET=

# Optional stats-API client tag. Leave empty if you don't have one.
CLIENT_TAG=

# Optional Twitch extension backend override (local EBS dev server, e.g.
# http://127.0.0.1:8787/twitch). Leave empty to use the public backend.
TWITCH_EBS_URL=

# Sentry Configuration (for crash reporting — leave empty to disable)
SENTRY_DSN=

# Sentry CLI (for source map upload in CI — not needed locally)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
